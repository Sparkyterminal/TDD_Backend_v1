# Copy to .env (never commit .env). Required keys are marked *.

# --- Server ---
DANCE_DISTRICT_PORT=4044

# --- Database * ---
DANCE_DISTRICT_DB_URL=mongodb+srv://<user>:<password>@<cluster>/dance_district

# --- Auth * ---
DANCE_DISTRICT_JWT_SECRET=<long-random-string>
DANCE_DISTRICT_TOKEN_VALIDITY=1d
DANCE_DISTRICT_TOKEN_MAX_VALIDITY=7d

# --- PhonePe Standard Checkout * ---
CLIENT_ID=
CLIENT_SECRET=
# PHONEPE_ENV=PRODUCTION          # or SANDBOX for testing
# PHONEPE_CLIENT_VERSION=1

# --- MSG91 WhatsApp ---
MSG91_AUTHKEY=
WHATSAPP_NUMBER=

# --- Public URLs (defaults shown) ---
# FRONTEND_URL=https://www.thedancedistrictbysahitya.in
# PUBLIC_API_URL=https://www.thedancedistrictbysahitya.in/api
# CORS_ORIGINS=https://www.thedancedistrictbysahitya.in,https://thedancedistrictbysahitya.in

# --- Business settings (defaults shown) ---
# STUDIO_CONTACT_NUMBER=+91 8073139244
# STUDIO_ADDRESS=The Dance District Studio, Gubalaala Main Road Bengaluru
# MEMBERSHIP_REGISTRATION_FEE=500
# WORKSHOP_PROCESSING_FEE=50

# --- Jobs ---
# ENABLE_CRON=true
